# Copy this file to ".env" and fill it in. Never commit .env.

PORT=3000

# Your own email: unlocks the Admin tab (approve students, see payments).
ADMIN_EMAIL=you@example.com

# Set to 1 when the site is served over https (marks the login cookie "Secure").
COOKIE_SECURE=0

# Where the database lives. Back this file up.
# DB_FILE=./data/tunu.db

# ---------------- M-Pesa (Safaricom Daraja) ----------------
# Leave MPESA_CONSUMER_KEY empty to run in DEMO mode: payments are simulated, no money moves.
MPESA_ENV=sandbox                 # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379            # sandbox default. Production: your Paybill / Till (store) number
MPESA_PASSKEY=                    # from the Daraja "Test Credentials" page (sandbox) or Safaricom (production)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # Till numbers use CustomerBuyGoodsOnline
# MPESA_PARTY_B=                  # Till number if it differs from MPESA_SHORTCODE

# Public https address of THIS app, so Safaricom can reach the callback. While testing: `ngrok http 3000`
PUBLIC_URL=https://your-name.ngrok-free.app
# Any long random string. It becomes part of the callback URL so strangers can't fake payments.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MPESA_CALLBACK_SECRET=
